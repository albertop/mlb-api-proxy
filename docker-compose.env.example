# Environment Variables for Portainer Stack Deployment
# Copy these variables to Portainer's "Environment variables" section when creating/updating the stack

# ===========================================
# IMAGE CONFIGURATION
# ===========================================
IMAGE_VERSION=1.2026.10
EXTERNAL_PORT=3002

# ===========================================
# SECURITY (REQUIRED)
# ===========================================
# Change this to a secure API key for production
PROXY_API_KEY=your-secure-api-key-here

# Allowed CORS origins for the browser front-end (comma-separated).
# Empty = no cross-origin access. Never use "*" in production.
# Example: CORS_ALLOW_ORIGINS=https://mi-website.com,https://www.mi-website.com
CORS_ALLOW_ORIGINS=

# Expose interactive API docs (/docs, /redoc, /openapi.json). Set to false in public prod.
ENABLE_DOCS=true

# ===========================================
# MLB API CONFIGURATION
# ===========================================
MLB_BASE_URL=https://statsapi.mlb.com
UPSTREAM_TIMEOUT_SECONDS=30.0

# Optional: If MLB API requires authentication
UPSTREAM_BEARER_TOKEN=
UPSTREAM_BASIC_AUTH=

# ===========================================
# RESILIENCE / HTTP CLIENT (optional — sane defaults shown)
# ===========================================
# Shared connection pool (R1). On a small VPS you can lower these to cap memory.
UPSTREAM_MAX_CONNECTIONS=100
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20
# Fast connect timeout so a down upstream is detected quickly (R5).
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
# Retry policy for transient upstream failures: timeouts, connection errors, 502/503/504 (R2).
# 429 is never retried (passed through). Set UPSTREAM_MAX_RETRIES=0 to disable retries.
UPSTREAM_MAX_RETRIES=2
UPSTREAM_BACKOFF_BASE_SECONDS=0.5
UPSTREAM_BACKOFF_MAX_SECONDS=5.0

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
# In-process cache is per-worker: keep workers low so the cache is shared effectively.
# 1 = best cache hit-rate; 2 = uses a second core for XML/JSON parsing. Recommended: 1-2.
WORKERS=2

# ===========================================
# RESPONSE CACHE (in-process, per-worker)
# ===========================================
# On by default. Set to false to disable entirely.
ENABLE_CACHE=true
# Max cached entries PER TTL tier (memory bound). ~1000 = a few MB.
CACHE_MAXSIZE=1000
# TTL (seconds) for semi-dynamic data: schedule, standings, stats, rosters.
CACHE_TTL_DEFAULT=300
# TTL (seconds) for reference/lookup data: teams, venues, sports, *types, *status.
CACHE_TTL_STATIC=21600

# ===========================================
# PORTAINER DEPLOYMENT NOTES
# ===========================================
# 1. Go to Portainer > Stacks > Add Stack
# 2. Name: mlb-api-proxy
# 3. Build method: Repository or Upload docker-compose.yml
# 4. Copy the variables above to "Environment variables" section
# 5. Update PROXY_API_KEY with a secure value
# 6. Adjust WORKERS based on your server CPU (recommended: 2 x CPU cores + 1)
# 7. Click "Deploy the stack"
# 
# Health Check: http://your-server:8000/health
